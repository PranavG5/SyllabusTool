# ---------------------------------------------------------------------------
# Public (safe to ship in the client bundle)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only. NEVER prefix any of these with NEXT_PUBLIC_.
# `npm run test:unit` includes a guard test that fails the build if a secret
# name leaks into a client component.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# 32-byte key, base64. Encrypts stored Google OAuth refresh tokens at rest.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Shared secret the enqueue endpoint uses to call the background worker route.
#   openssl rand -hex 32
JOB_WORKER_SECRET=

# Google Calendar OAuth (calendar scope is "sensitive" -> app verification required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Error tracking (optional in development)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Test-only
# ---------------------------------------------------------------------------
# Postgres used by tests/rls. Any empty database works; the suite applies the
# real migrations from supabase/migrations plus a small Supabase auth shim.
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:55432/postgres
# Set to 1 to run tests/accuracy, which makes real Anthropic API calls.
RUN_ACCURACY_TESTS=0
